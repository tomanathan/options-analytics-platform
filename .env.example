# Copy to .env and edit. .env is gitignored; never commit real values.

# --- Airflow (docker-compose.yml) ---
# Host user id the Airflow containers run as. On Linux set to `id -u`.
AIRFLOW_UID=50000
# Login for the Airflow UI at http://localhost:8080 (local stack only).
_AIRFLOW_WWW_USER_USERNAME=airflow
# pragma: allowlist nextline secret
_AIRFLOW_WWW_USER_PASSWORD=airflow

# --- AWS (bronze layer: S3 + Glue; created by infra/) ---
AWS_REGION=us-east-1
# Named profile in ~/.aws/credentials holding the oap-pipeline user's key (created by infra/).
# Terraform uses a separate admin profile, oap-admin; see docs/runbook.md.
AWS_PROFILE=oap-pipeline
# Bucket created by terraform; must match the bucket_name variable.
OAP_S3_BUCKET=
# Glue Catalog database holding the Iceberg bronze tables.
OAP_GLUE_DATABASE=oap_bronze

# --- Iceberg catalog (bronze table bronze.option_chain) ---
# sql = local SQLite catalog and file warehouse under .iceberg-local/ (default). glue = AWS Glue + S3.
OAP_ICEBERG_CATALOG=sql
# Catalog database URI for the sql catalog. These relative paths also work in the Airflow containers,
# whose working directory is /opt/airflow and where ./.iceberg-local is mounted.
OAP_ICEBERG_URI=sqlite:///.iceberg-local/catalog.db
# Where table data files are written. For AWS use s3://<OAP_S3_BUCKET>/bronze with OAP_ICEBERG_CATALOG=glue.
OAP_ICEBERG_WAREHOUSE=file://./.iceberg-local/warehouse
# Containers cannot read ~/.aws profiles. For the glue catalog inside Airflow, export the oap-pipeline
# user's key in the shell that runs docker compose (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY); never store it here.

# --- dbt (dbt/profiles.yml) ---
# dev = local DuckDB file, no credentials. prod = Snowflake, needs the vars below.
DBT_TARGET=dev

# --- Snowflake (only read when DBT_TARGET=prod) ---
# Account identifier, e.g. orgname-accountname.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# --- Alpaca market data (daily snapshot; the DoltHub backfill needs no key) ---
# Free-tier indicative feed. Keys go here only, never in git.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
